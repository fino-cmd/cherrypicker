# python cache
__pycache__/
backend/__pycache__/
*.pyc

# claude local settings
.claude/settings.local.json

# secrets — never commit
.env
.env.local
.env.*.local
*.key
backend/.env

# DB backups / stale snapshots (regenerated by app)
*.db.prev_unmerged
*.db.stale*
*.db.bak

# Backups folder (local rolling DB snapshots)
backups/

# Stray pip / conda output files
=*.*

# Claude worktrees (per-task scratch dirs)
.claude/worktrees/
