# python cache
__pycache__/
backend/__pycache__/
*.pyc

# claude local settings
.claude/settings.local.json

# secrets — never commit
.env
.env.local
.env.*.local
*.key
backend/.env

# DB backups / stale snapshots (regenerated by app)
*.db.prev_unmerged
*.db.stale*
*.db.bak

# Backups folder (local rolling DB snapshots)
backups/

# Stray pip / conda output files
=*.*

# Claude worktrees (per-task scratch dirs)
.claude/worktrees/

# AltLines on-disk API cache (odds/rosters/game logs)
data/altlines/cache/

# Futbol: caches de ESPN/OddsPapi/fotos y salidas generadas
data/futbol/cache/
data/futbol/jornada.json
data/futbol/backtest_predictions.csv.gz
data/futbol/picks.db
data/futbol/prefs.json
