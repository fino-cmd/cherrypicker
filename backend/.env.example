# Odds API — get a key at https://the-odds-api.com (free tier available)
# Leave empty to skip K-line fetching (model projections still work)
ODDS_API_KEY=

# Path to SQLite database file (relative to the backend/ directory)
DB_PATH=tracker.db

# How long to cache pybaseball / MLB API responses (hours)
CACHE_TTL_HOURS=6
